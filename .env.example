# ── PathPulse Backend Core — environment template ──
# Copy to .env and fill in. NEVER commit the real .env.

# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- Stellar network (Phases 1–4 = testnet only) ---
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Managed distribution accounts (testnet public keys only here) ---
# Private keys live in AWS KMS, NEVER in this file on mainnet.
PARTNER_REVENUE_PUBLIC=
DRIVER_POOL_PUBLIC=
TREASURY_PUBLIC=

# --- Treasury multisig signers (testnet) ---
# Human-gated: signer set is approved manually, never auto-provisioned.
TREASURY_SIGNER_1_PUBLIC=
TREASURY_SIGNER_2_PUBLIC=
TREASURY_SIGNER_3_PUBLIC=
TREASURY_THRESHOLD_LOW=2
TREASURY_THRESHOLD_MED=2
TREASURY_THRESHOLD_HIGH=2

# --- KMS-backed signing (dev tier for Phase 1) ---
# dev | aws-kms
SIGNER_BACKEND=dev
KMS_KEY_ID=

# --- Auth / sessions ---
# Frontend origin — used for CORS.
WEB_APP_URL=http://localhost:3000
# Must be set (and kept secret) in production. Dev falls back to an insecure default.
SESSION_SECRET=
# SEP-10 server signing key. If unset, an ephemeral dev keypair is generated at
# startup (resets on restart) — fine for local dev, never for production.
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost:8080
# Operator access: comma-separated Google emails and/or Stellar wallet addresses
# allowed to unlock the ops role (plus OPS_PASSCODE). Required in production.
OPS_OPERATORS=
OPS_PASSCODE=
GOV_PARTNER_PASSCODE=
OPS_ROLE_TTL_SECONDS=900
PARTNER_ROLE_TTL_SECONDS=28800
# Reserve-sponsor guard rails (mainnet sponsored reserves and fee bumps).
SPONSOR_MAX_ACCOUNTS_PER_HOUR=20
SPONSOR_MAX_FEE_BUMPS_PER_HOUR=300
SPONSOR_MIN_BALANCE_XLM=2
# Chain indexer poll interval for the gov ledger (0 disables it).
INDEXER_INTERVAL_MS=60000
# Error reporting (optional). NEXT_PUBLIC_SENTRY_DSN is baked into the web build.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Google OAuth client ID (Google Cloud Console → Credentials). Must match the
# NEXT_PUBLIC_GOOGLE_CLIENT_ID used by the web app.
GOOGLE_CLIENT_ID=

# --- Datastores ---
DATABASE_URL=postgres://pathpulse:pathpulse@localhost:5432/pathpulse
KEY_ENCRYPTION_KEY=
REDIS_URL=redis://localhost:6379

# --- External dependencies (initiated Week 1; sandbox until approved) ---
# Stellar Disbursement Platform — driver-rewards payout rail (D2/D3).
# Leave blank to run the sandbox stub. Live requires all four below.
SDP_BASE_URL=http://localhost:8000
SDP_API_KEY=
SDP_WALLET_ID=
SDP_ASSET_ID=
SDP_REGISTRATION_CONTACT_TYPE=PHONE_NUMBER_AND_WALLET_ADDRESS
SDP_VERIFICATION_FIELD=DATE_OF_BIRTH

# Ramp Network off-ramp (D4). Widget-based: we build a signed off-ramp widget URL and
# receive ECDSA-signed V3 webhooks. Leave RAMP_API_KEY blank to run the sandbox stub.
RAMP_API_KEY=              # Ramp host API key (from Ramp; staging first)
RAMP_WIDGET_URL=https://app.demo.ramp.network   # prod: https://app.ramp.network
RAMP_WEBHOOK_PUBLIC_KEY=   # Ramp ECDSA public key (PEM) to verify X-Body-Signature
RAMP_HOST_APP_NAME=PathPulse
PUBLIC_API_URL=            # public URL of THIS backend so Ramp can reach /v1/offramp/callback (tunnel in dev)
# Corridor. Ramp off-ramps XLM on Stellar (Stellar-USDC not in the off-ramp list); INR IS supported.
OFFRAMP_CRYPTO=XLM
OFFRAMP_ASSET_ID=XLM_XLM   # Ramp asset id: CHAIN_SYMBOL
OFFRAMP_FIAT=INR
OFFRAMP_INDICATIVE_RATE=30 # sandbox stub estimate only (live: Ramp quote)

# ── Carret Infra off-ramp (D4 · alt provider) ──────────────────────────
# Pure REST, no widget. Corridor: USDC on Stellar → INR (bank_transfer).
# Leave CARRET_API_KEY blank to run the mocked sandbox stub. To switch the
# active provider from Ramp to Carret, set OFFRAMP_PROVIDER=carret.
# NOTE: chain uses the *token symbol* (XLM for Stellar, TRX for Tron, etc.).
OFFRAMP_PROVIDER=ramp        # 'ramp' | 'carret'
CARRET_API_KEY=              # Carret Infra API key (from contact@carret.in)
CARRET_BASE_URL=https://dev.carret.in/api/v1/taas   # prod: https://prod.carret.in/api/v1/taas
CARRET_ACCOUNT_ID=           # Partner main/sub account id (integer)
CARRET_CRYPTO=USDC
CARRET_CHAIN=XLM             # Stellar network = XLM (Carret's token-symbol convention)
CARRET_FIAT=INR
CARRET_BANK_ID=              # Registered bank_id (int) for the off-ramp payout
CARRET_WEBHOOK_SECRET=       # HMAC secret for X-Carret-Signature (scheme TBD with Carret)
CARRET_INDICATIVE_RATE=84    # sandbox stub estimate only (live: Carret quote)
CARRET_HTTPS_PROXY=          # forward proxy for Carret calls only, e.g. http://user:pass@1.2.3.4:8888
                            # Carret IP-blocks cloud egress; the deployed backend needs a whitelisted static IP
# DEV-ONLY escape hatch — lets Carret run when STELLAR_NETWORK=testnet so devs
# can click the web UI end-to-end. Every Carret API call still fires; the
# on-chain deposit part is skipped (no real USDC ever leaves). NEVER set true
# in production — testnet USDC into a mainnet deposit address vanishes.
CARRET_ALLOW_TESTNET=false
# Circle USDC issuer on Stellar mainnet. Overridable only if Carret ever
# requests a different wrapped asset. On mainnet the backend uses this to
# build the deposit payment to Carret's receiving address.
CARRET_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ── Error monitoring (Sentry) ───────────────────────────────────────────
# All four surfaces (backend, web, iOS, Android) stay silent when the DSN
# is unset. Add a DSN per project in your Sentry org to turn it on.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Web surface — exposed to the browser so prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Cross-asset routing (D5) — testnet only ─────────────────────────────────
# Aquarius and StellarBroker both quote; Aquarius is chosen when it can execute
ROUTING_QUOTE_TIMEOUT_MS=3000
ROUTING_SLIPPAGE_BPS=100   # 100 = 1%
# Routable asset set: CODE or CODE:ISSUER, comma-separated. Empty ⇒ XLM + Circle testnet USDC/EURC.
ROUTING_ASSETS=
# Which routable asset the treasury plan converts non-settlement holdings into.
ROUTING_SETTLEMENT_ASSET=USDC

# Aquarius router contract address. Testnet: CBCFTQSPDBAIZ6R6PJQKSQWKNKWH2QIV3I4J72SHWBIK3ADRRAM5A6GD
# (mainnet router is CBQDHNBFBZYE4MKPWBSJOPIYLW4SFSXAXUTSXJN76GNKYVYPCKWC6QUK — Phase 5, gated)
AQUA_ROUTER_CONTRACT=CBCFTQSPDBAIZ6R6PJQKSQWKNKWH2QIV3I4J72SHWBIK3ADRRAM5A6GD
AQUA_API_URL=https://amm-api-testnet.aqua.network/api/external/v2
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# StellarBroker multi-source router. Quotes work keyless; execution needs a partner key.
STELLARBROKER_PARTNER_KEY=
STELLARBROKER_API_URL=https://api.stellar.broker
STELLARBROKER_MAX_SLIPPAGE_BPS=200

# PulseGen validation-score feed (D6). PulseGen is PathPulse.ai's own engine and
# has no endpoint yet; leave blank to use delivered batches or the synthetic interim.
# For local integration testing run scripts/pulsegen-stub.ts and point these at it.
# Both are REQUIRED on mainnet — the service refuses to boot without them.
PULSEGEN_BASE_URL=
PULSEGEN_API_KEY=
PULSEGEN_STUB_KEY=          # pins the stub's bearer token; random per run if unset
# One of PULSEGEN_BASE_URL+API_KEY, PATHPULSE_INTERNAL_SCORER=true, or
# PULSEGEN_PILOT_SYNTHETIC=true must be set on mainnet.
# PATHPULSE_INTERNAL_SCORER=true computes a defensible 0..1 score from signals
# PathPulse already captures (KYC, verified bank, settlement participation,
# off-ramp activity, account age, payout success). See
# backend/src/services/pathpulseInternalScore.ts for the weights.
PATHPULSE_INTERNAL_SCORER=false
PULSEGEN_PILOT_SYNTHETIC=false
SETTLEMENT_DEPOSIT_SENDERS=
