# ── PathPulse Backend Core — environment template ──
# Copy to .env and fill in. NEVER commit the real .env.

# --- Runtime ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=debug

# --- Stellar network (Phases 1–4 = testnet only) ---
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# --- Managed distribution accounts (testnet public keys only here) ---
# Private keys live in KMS/HSM, NEVER in this file on mainnet.
PARTNER_REVENUE_PUBLIC=
DRIVER_POOL_PUBLIC=
TREASURY_PUBLIC=

# --- Treasury multisig signers (testnet) ---
# Human-gated: signer set is approved manually, never auto-provisioned.
TREASURY_SIGNER_1_PUBLIC=
TREASURY_SIGNER_2_PUBLIC=
TREASURY_SIGNER_3_PUBLIC=
TREASURY_THRESHOLD_LOW=2
TREASURY_THRESHOLD_MED=2
TREASURY_THRESHOLD_HIGH=2

# --- KMS-backed signing (dev tier for Phase 1) ---
# dev | aws-kms | gcp-kms | hsm
SIGNER_BACKEND=dev
KMS_KEY_ID=

# --- Auth / sessions ---
# Frontend origin — used for CORS.
WEB_APP_URL=http://localhost:3000
# Must be set (and kept secret) in production. Dev falls back to an insecure default.
SESSION_SECRET=
# SEP-10 server signing key. If unset, an ephemeral dev keypair is generated at
# startup (resets on restart) — fine for local dev, never for production.
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost:8080
# Google OAuth client ID (Google Cloud Console → Credentials). Must match the
# NEXT_PUBLIC_GOOGLE_CLIENT_ID used by the web app.
GOOGLE_CLIENT_ID=

# --- Datastores ---
DATABASE_URL=postgres://pathpulse:pathpulse@localhost:5432/pathpulse
REDIS_URL=redis://localhost:6379

# --- External dependencies (initiated Week 1; sandbox until approved) ---
SDP_BASE_URL=
SDP_API_KEY=

# Mercuryo SEP-24 off-ramp (D4). Leave blank to run the sandbox stub.
# Live off-ramp requires ALL THREE of: SEP24_URL + WIDGET_ID + SECRET.
MERCURYO_SEP24_URL=          # anchor TRANSFER_SERVER_SEP0024 (from Mercuryo's stellar.toml)
MERCURYO_HOME_DOMAIN=        # anchor home domain hosting stellar.toml (for SEP-10 auth)
MERCURYO_WIDGET_ID=          # widget/partner id used to sign the hosted interactive URL
MERCURYO_SECRET=             # widget/API secret
MERCURYO_BASE_URL=           # Mercuryo API base (sandbox)
# Off-ramp corridor defaults
OFFRAMP_FIAT=INR
OFFRAMP_INDICATIVE_RATE=83   # indicative fiat per 1 stablecoin unit (sandbox estimate only)
OFFRAMP_ASSET_CODE=USDC
OFFRAMP_ASSET_ISSUER=        # USDC issuer on the target network
